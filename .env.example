# Environment variables used by Folioform. This file is a template with NO real values.
# Real values go in .env.local on your computer (git-ignored) and in
# Vercel → Settings → Environment Variables for deployments.
# Never prefix a secret with NEXT_PUBLIC_ — that would send it to the browser.

# --- Required ---------------------------------------------------------------
# Neon Postgres connection string (pooled). Already set in Vercel for Preview.
DATABASE_URL=

# Claude API key from the Claude Console (platform.claude.com → API keys). Starts with sk-ant-
ANTHROPIC_API_KEY=

# --- Optional (sensible defaults are built in) -------------------------------
# ANTHROPIC_MODEL=claude-sonnet-5-5      # model used for generation
# ANTHROPIC_EFFORT=medium                # low | medium | high — higher is slower and costs more
# GENERATION_LIMIT_FREE=3                # generations per free account per 24 h
# GENERATION_LIMIT_PAID=10               # generations per paid account per 24 h
# GENERATION_LIMIT_GLOBAL=100            # generations across the whole site per 24 h

# --- Local only (used by `npm run db:setup`, not needed on Vercel) ------------
DEMO_PASSWORD=

# Added in Step 5 (payments):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

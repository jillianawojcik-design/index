# Copy this file to .env.local and fill in real values. .env.local is git-ignored.
# Nothing is required yet — these are added one feature at a time.
#
# Step 2 (accounts):   DATABASE_URL=            # Neon Postgres connection string
# Step 3 (AI):         ANTHROPIC_API_KEY=
# Step 5 (payments):   STRIPE_SECRET_KEY=
#                      STRIPE_WEBHOOK_SECRET=
#
# Never prefix a secret with NEXT_PUBLIC_ — that would send it to the browser.

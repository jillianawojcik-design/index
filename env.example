# Environment variables used by Folioform. This file is a template with NO real values.
# Real values go in .env.local (or .env, which `neon init` writes). Both are git-ignored.
# On Vercel, add them under Settings → Environment Variables instead.

# Neon Postgres connection string (Neon Console → Connect, with "Connection pooling" on).
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Added in later steps:
# ANTHROPIC_API_KEY=        (Step 3, AI generator)
# STRIPE_SECRET_KEY=        (Step 5, payments)
# STRIPE_WEBHOOK_SECRET=    (Step 5, payments)

# Never prefix a secret with NEXT_PUBLIC_ — that would send it to the browser.
